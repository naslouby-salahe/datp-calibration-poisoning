{
  "include": ["src"],
  "exclude": [
    "**/node_modules",
    "**/.*",
    "**/.venv/**",
    "**/venv/**",
    "**/.tox/**",
    "**/.mypy_cache/**",
    "**/.pytest_cache/**",
    "**/__pycache__/**",
    "**/site-packages/**",
    "**/.vscode-server/**"
  ],
  "ignore": [
    "**/.vscode-server/**",
    "**/site-packages/**",
    "**/dist-packages/**"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "standard",
  "reportPrivateImportUsage": "none",
  "reportUnsupportedDunderAll": "none"
}
